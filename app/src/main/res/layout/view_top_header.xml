<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/topHeaderContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="18dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="18dp"
    android:background="@drawable/bg_top_header_glass"
    android:elevation="18dp"
    android:minHeight="72dp"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/topHeaderBack"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_top_header_icon"
        android:contentDescription="@string/back"
        android:padding="11dp"
        android:src="@drawable/ic_arrow_back_neon"
        android:tint="@color/protask_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/topHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/protask_text"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/topHeaderBack"
        app:layout_constraintEnd_toStartOf="@id/topHeaderActions"
        app:layout_constraintStart_toEndOf="@id/topHeaderBack"
        app:layout_constraintTop_toTopOf="@id/topHeaderBack" />

    <LinearLayout
        android:id="@+id/topHeaderActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/topHeaderSecondaryAction"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_top_header_icon"
            android:contentDescription="@string/header_action"
            android:padding="10dp"
            android:tint="@color/protask_glow"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/topHeaderPrimaryAction"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_top_header_icon"
            android:contentDescription="@string/header_action"
            android:padding="10dp"
            android:tint="@color/protask_glow"
            android:visibility="gone" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:endColor="#3D5B8CFF"
                android:startColor="#4A7B2CFF" />
            <stroke
                android:width="1dp"
                android:color="#77FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:angle="135"
                android:endColor="#AA151A2E"
                android:startColor="#66313B64" />
            <stroke
                android:width="1dp"
                android:color="#4D8EA4FF" />
        </shape>
    </item>
</selector>

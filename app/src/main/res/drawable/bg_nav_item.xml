<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="25dp" />
            <gradient
                android:angle="135"
                android:startColor="#AA7B2CFF"
                android:centerColor="#6638BDF8"
                android:endColor="#44D946EF" />
            <stroke
                android:width="1dp"
                android:color="#D7C2FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="25dp" />
            <solid android:color="#557B2CFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="25dp" />
            <solid android:color="#10151A2E" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_neon">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="104dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <include layout="@layout/view_top_header" />

            <TextView
                style="@style/ProTaskScreenTitle"
                android:layout_marginTop="20dp"
                android:text="Invite. Earn. Repeat." />

            <TextView
                style="@style/ProTaskBodyText"
                android:layout_marginTop="6dp"
                android:text="Share your referral code and unlock bonus rewards when friends join ProTask." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_wallet_glow"
                android:elevation="24dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:text="PROTASK250"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/ProTaskBodyText"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Your premium referral code" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/ProTaskMetricCard">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="+100"
                        android:textColor="#2DD4BF"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/ProTaskBodyText"
                        android:gravity="center"
                        android:text="Per signup" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout style="@style/ProTaskMetricCard">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="No Cap"
                        android:textColor="#FFFFFF"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/ProTaskBodyText"
                        android:gravity="center"
                        android:text="Invite limit" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnShareReferral"
                style="@style/ProTaskNeonButton"
                android:layout_marginTop="24dp"
                android:text="Share Referral Code"
                android:translationZ="8dp" />
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_gravity="bottom" />
</FrameLayout>

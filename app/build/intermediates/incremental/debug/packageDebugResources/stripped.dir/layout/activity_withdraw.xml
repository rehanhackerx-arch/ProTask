<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/protask_bg"
    tools:context=".WithdrawActivity">

    <include
        android:id="@+id/topHeader"
        layout="@layout/view_top_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintTop_toBottomOf="@id/topHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Withdraw Balance Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="@drawable/bg_premium_card"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvAvailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Available Balance"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvWithdrawCoinBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Coins"
                    android:textColor="@color/protask_text"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAvailLabel" />

                <TextView
                    android:id="@+id/tvWithdrawInrBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="≈ ₹0.00"
                    android:textColor="#CCFFFFFF"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvWithdrawCoinBalance"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvWithdrawCoinBalance" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Payment Methods -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Select Payment Method"
                android:textColor="@color/protask_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- UPI -->
                    <LinearLayout
                        android:id="@+id/methodUpi"
                        android:layout_width="120dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_wallet_glow"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_menu_send"
                            app:tint="@color/protask_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="UPI"
                            android:textColor="@color/protask_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Paytm -->
                    <LinearLayout
                        android:id="@+id/methodPaytm"
                        android:layout_width="120dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_glass_card"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_menu_save"
                            app:tint="@color/protask_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Paytm"
                            android:textColor="@color/protask_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Google Pay (GPay) -->
                    <LinearLayout
                        android:id="@+id/methodGPay"
                        android:layout_width="120dp"
                        android:layout_height="100dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_glass_card"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_menu_share"
                            app:tint="@color/protask_text" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="GPay"
                            android:textColor="@color/protask_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- GPay / Payment Number Input -->
            <TextView
                android:id="@+id/tvInputLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Enter GPay Number"
                android:textColor="@color/protask_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPaymentDetail"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_input_field"
                android:hint="Mobile number or UPI ID"
                android:inputType="text"
                android:paddingHorizontal="20dp"
                android:textColor="@color/protask_text"
                android:textColorHint="#60FFFFFF" />

            <!-- Amount Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Enter Amount (Points)"
                android:textColor="@color/protask_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_input_field"
                android:hint="Min. 50,000 Points"
                android:inputType="number"
                android:paddingHorizontal="20dp"
                android:textColor="@color/protask_text"
                android:textColorHint="#60FFFFFF" />

            <TextView
                android:id="@+id/tvInrConversion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="INR Value: ₹0.00"
                android:textColor="#B0AFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Withdraw Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmitWithdraw"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_neon_button"
                android:text="Withdraw Now"
                android:textAllCaps="false"
                android:textColor="@color/protask_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Rules Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="15dp">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Withdrawal Rules:"
                    android:textColor="@color/protask_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="• Minimum withdrawal: 50,000 pts (₹50)"
                    android:textColor="#B0AFFF"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="• Requests are processed within 24-48 hours."
                    android:textColor="#B0AFFF"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <include layout="@layout/layout_bottom_nav" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

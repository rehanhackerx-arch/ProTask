<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_neon">

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-48dp"
        android:layout_marginEnd="-64dp"
        android:alpha="0.78"
        android:background="@drawable/bg_circle_glow" />

    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-50dp"
        android:layout_marginBottom="120dp"
        android:alpha="0.36"
        android:background="@drawable/bg_circle_glow" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/captchaRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <include layout="@layout/view_top_header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_captcha_timer_chip"
                    android:elevation="10dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wallet"
                        android:textColor="#97A3CE"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvPointsBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 pts"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/ProTaskScreenTitle"
                android:layout_marginTop="20dp"
                android:text="Captcha Typing" />

            <TextView
                style="@style/ProTaskBodyText"
                android:layout_marginTop="8dp"
                android:text="Verify the secure neon code before the timer runs out to unlock instant reward points." />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCaptchaHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_captcha_glass_card"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Secure Neon Captcha"
                                android:textColor="@android:color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Refresh anytime for a new challenge"
                                android:textColor="#91A0CC"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCaptchaTimer"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_captcha_timer_chip"
                            android:gravity="center"
                            android:minWidth="70dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="45s"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="154dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_captcha_text_glow"
                        android:clipToPadding="true"
                        android:paddingStart="18dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="20dp">

                        <TextView
                            android:id="@+id/tvCaptcha"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:letterSpacing="0.28"
                            android:text="T 6 T K G V"
                            android:textAllCaps="true"
                            android:textColor="@android:color/white"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/viewCardShimmer"
                            android:layout_width="86dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_captcha_shimmer_strip"
                            android:rotation="12" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvCaptchaStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Type the glowing captcha exactly as shown."
                            android:textColor="#ABBAE6"
                            android:textSize="13sp" />

                        <ImageButton
                            android:id="@+id/btnRefreshCaptcha"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="16dp"
                            android:background="@drawable/bg_captcha_icon_button"
                            android:contentDescription="Refresh captcha"
                            android:padding="14dp"
                            android:src="@android:drawable/ic_popup_sync"
                            android:tint="@android:color/white" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressTimer"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="16dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/bg_captcha_timer_progress" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardInputSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_captcha_glass_card"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Type Your Answer"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Uppercase letters and numbers only"
                        android:textColor="#91A0CC"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCaptchaInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:hint="Enter captcha"
                        app:boxBackgroundColor="#1E202C"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="30dp"
                        app:boxCornerRadiusBottomStart="30dp"
                        app:boxCornerRadiusTopEnd="30dp"
                        app:boxCornerRadiusTopStart="30dp"
                        app:boxStrokeColor="#7B2CFF"
                        app:boxStrokeErrorColor="@color/protask_glow"
                        app:boxStrokeWidth="2dp"
                        app:boxStrokeWidthFocused="3dp"
                        app:hintAnimationEnabled="true"
                        app:hintTextColor="@color/protask_blue">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCaptchaInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="textCapCharacters"
                            android:maxLength="6"
                            android:minHeight="60dp"
                            android:paddingStart="18dp"
                            android:paddingTop="18dp"
                            android:paddingEnd="18dp"
                            android:paddingBottom="18dp"
                            android:textColor="@android:color/white"
                            android:textColorHint="#7D88B5"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvTypingProgress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="0/6 typed"
                            android:textColor="@android:color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+10 per solve"
                            android:textColor="#2DD4BF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressTyping"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="10dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_captcha_typing_progress" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/ProTaskMetricCard"
                    android:background="@drawable/bg_captcha_glass_card">

                    <TextView
                        android:id="@+id/tvRewardValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="+10"
                        android:textColor="#2DD4BF"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/ProTaskBodyText"
                        android:gravity="center"
                        android:text="Reward per captcha" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    style="@style/ProTaskMetricCard"
                    android:background="@drawable/bg_captcha_glass_card">

                    <TextView
                        android:id="@+id/tvDailyCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="0/10"
                        android:textColor="@android:color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/ProTaskBodyText"
                        android:gravity="center"
                        android:text="Solved today" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRewardProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_captcha_glass_card"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Daily completion progress"
                            android:textColor="@android:color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvProgressLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 of 10 complete"
                            android:textColor="#9FADD6"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progressDaily"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="14dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/bg_captcha_typing_progress" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Stay inside the neon timer window. Refresh whenever the code feels unreadable."
                        android:textColor="#90A0D4"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifyCaptcha"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_captcha_verify_button"
                android:elevation="18dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Verify Captcha"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="30dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWatchAdCaptcha"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:elevation="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Watch Ad for Bonus Points"
                android:textAllCaps="false"
                android:textColor="@color/protask_blue"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="30dp"
                app:strokeColor="@color/protask_blue"
                app:strokeWidth="1dp" />

            <TextView
                style="@style/ProTaskBodyText"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Rewards post instantly after successful verification."
                android:textColor="#8896C4" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/rewardPopupOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A60A1020"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/rewardPopupCard"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_neon_panel"
            android:elevation="22dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_captcha_text_glow"
                android:gravity="center"
                android:text="OK"
                android:textColor="@android:color/white"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPopupReward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="+10 Points"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPopupMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Captcha completed. Neon reward transferred to your wallet."
                android:textColor="#C2CEFF"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
